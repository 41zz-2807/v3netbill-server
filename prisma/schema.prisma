generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  KASIR
}

enum PcStatus {
  IDLE
  ACTIVE
  OFFLINE
}

enum AccountType {
  VOUCHER
  MEMBER
}

enum AccountStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SessionStatus {
  BERJALAN
  SELESAI
  DISTOP
}

enum TransactionType {
  BELI_BARU
  TOPUP
  KOREKSI
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  passwordHash  String
  role          Role
  createdAt     DateTime @default(now())
  transactions  Transaction[]
  devices       Perangkat[]
}

/// Token perangkat untuk notifikasi push (FCM).
///
/// Token diikat ke user, bukan ke satu perangkat fisik: begitu akun dihapus,
/// semua token-nya ikut terhapus. `onDelete: Cascade` itu wajib ditulis
/// eksplisit karena seluruh skema ini tidak memakai `onDelete` sama sekali,
/// jadi default-nya RESTRICT dan penghapusan user akan ditolak PostgreSQL.
model Perangkat {
  id         String   @id @default(uuid())
  token      String   @unique
  platform   String   @default("android")
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model Pc {
  id               String   @id @default(uuid())
  namaPc           String
  ipClient         String
  status           PcStatus @default(IDLE)
  lastHeartbeatAt  DateTime?
  agentToken       String   @unique

  // ⚠️ `rusak` BUKAN berarti PC ini benar-benar rusak. Itu flag operasional:
  // operator menandainya saat PC sedang diservis atau sengaja dikosongkan.
  //
  // PC yang ditandai TIDAK muncul di dashboard, halaman login, dan aplikasi
  // mobile — hanya di Halaman PC, supaya flag bisa dibatalkan. Sesi baru
  // ditolak di `SessionService.createSessionAndStart()`, dan sesi yang sedang
  // berjalan langsung dihentikan saat flag dinyalakan.
  //
  // ⚠️ Kolom ini TIDAK boleh dipakai untuk menyaring laporan. Rekap dihitung
  // dari `Transaction`/`Session`, jadi PC yang ditandai tetap masuk rekap.
  rusak            Boolean  @default(false)
  alasanRusak      String?

  // ⚠️ Daya listrik PC dalam WATT, dipakai untuk estimasi biaya listrik di
  // laporan uptime. BUKAN kapasitas VA di meter — 2.200 VA itu kapasitas
  // sambungan, sedangkan satu PC hanya menarik 150-300 W.
  //
  // ⚠️ Default 150 W dipilih karena itu daya PC warnet lama/menengah yang
  // paling sering. PC dengan GPU berat bisa 300 W, jadi angka ini WAJIB bisa
  // diubah per PC lewat halaman PC Management.
  watt             Int      @default(150)

  // ⚠️ Kapan PC ini terakhir kali "dipakai". Dipakai untuk menghitung
  // hitung mundur auto-matikan: PC idle selama `Setting.auto_shutdown_menit`
  // menit dimatikan otomatis.
  //
  // ⚠️ JANGAN pernah di-update dari `heartbeat()`. Heartbeat datang tiap 15
  // detik, jadi kalau timer ikut di-reset di sana, hitung mundur tidak pernah
  // mencapai nol dan PC tidak pernah mati.
  //
  // Di-update hanya di tiga tempat: `registerPc()` (boot/reconnect),
  // `stopSession()` (sesi berakhir), dan `unlockPc()` (kasir buka kunci).
  //
  // `null` = tidak ada timer. Dipakai juga sebagai penanda "pernah dikirim",
  // supaya perintah mati tidak dikirim ulang setiap 10 detik.
  terakhirAktifAt  DateTime?

  sessions         Session[]
  uptime           UptimePc[]
}

/// Berapa lama tiap PC menyala, dihitung dari heartbeat.
///
/// ⚠️ 1 BARIS PER PC PER HARI, bukan 1 baris per heartbeat atau per menit.
/// Itu pilihan yang disengaja: 7 PC = 7 baris/hari (sekitar 5 MB/tahun),
/// sementara menyimpan tiap heartbeat mentah bisa 40.320 baris/hari
/// (sekitar 1,5 GB/tahun) untuk jawaban yang sama saja.
///
/// ⚠️ `dihitungSampai` itu yang membuat penghitungan ini BENAR. Tanpa kolom
/// ini, cara paling naif `detikOnline += 60` setiap tick akan salah besar:
/// cron yang jalan dua kali atau backend yang restart akan menghitung
/// période yang sama berulang kali. Dengan watermark, yang dihitung hanya
/// selisih sejak tick terakhir yang berhasil — jadi tick kedua menambah ~0.
///
/// `null` berarti PC tidak ada di tabel itu, dan itu disengaja: tabel ini
/// hanya berisi PC yang punya catatan, bukan satu baris untuk setiap PC
/// setiap hari.
model UptimePc {
  pcId String

  /// Tanggal dalam zona WIB, disimpan sebagai DATE.
  tanggal DateTime @db.Date

  /// Total heartbeat yang diterima, dalam detik. Maksimal 86.400 (=24 jam).
  detikOnline Int @default(0)

  /// Watermark: sudah dihitung sampai detik berapa.
  ///
  /// Seiring PC offline, watermark tetap dimajukan TANPA menambah
  /// `detikOnline` — itulah yang membuat jeda offline tidak ikut terhitung
  /// sebagai uptime.
  dihitungSampai DateTime

  pcs Pc @relation(fields: [pcId], references: [id], onDelete: Cascade)

  @@id([pcId, tanggal])
  @@index([tanggal])
}

model Account {
  id             String        @id @default(uuid())
  tipe           AccountType
  kodeUnik       String?       @unique
  nama           String?
  passwordHash   String
  sisaWaktuDetik Int           @default(0)
  status         AccountStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  lastUsedAt     DateTime?
  sessions       Session[]
  transactions   Transaction[]
}

/// Akun teknisi: bisa membuka layar kunci PC CLIENT tanpa waktu dan tanpa
/// billing. Berdiri sendiri dari `Account` — bukan voucher dan bukan member.
///
/// ⚠️ Kenapa tabel terpisah, bukan `Account` dengan tipe baru:
///   1. `Account` selalu menghasilkan `Transaction` dan `Session` yang ikut rekap
///      pendapatan. Teknisi justru harus TIDAK masuk hitungan itu.
///   2. `Account.nama` adalah kredensial login pelanggan dan ikut tampil di
///      daftar akun — tidak pantas dipakai untuk kredensial teknisi.
///   3. Satu akun saja, jadi `username` unik tanpa relasi apa pun.
model Teknisi {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  /// Sakelar utama. Dimatikan dari halaman admin kalau PIN bocor —
  /// tanpa perlu menghapus akun, jadi bisa dinyalakan lagi.
  aktif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Jejak akses teknisi yang sedang berjalan.
///
/// ⚠️ Sengaja TIDAK memakai tabel `Session`:
///   - `Session.accountId` punya FK `RESTRICT` ke `Account` yang tidak boleh
///     null, jadi sesi teknisi akan memaksa perubahan skema pada jalur yang
///     sedang menagih pelanggan.
///   - `Session` ikut dihitung sebagai `totalLogin` di laporan harian, dan
///     itu persis yang tidak boleh terjadi untuk teknisi.
///
/// Disimpan di database, bukan memory, karena indikator "ada teknisi di PC"
/// di dashboard harus tetap jujur setelah server restart.
model SesiTeknisi {
  id        String    @id @default(uuid())
  pcId      String
  username  String
  mulaiAt   DateTime  @default(now())
  /// `null` = masih berjalan. Baris yang sudah selesai dibersihkan berkala.
  selesaiAt DateTime?

  @@index([pcId])
  @@index([username])
}

model Session {
  id                    String        @id @default(uuid())
  pcId                  String
  pc                    Pc            @relation(fields: [pcId], references: [id])
  accountId             String
  account               Account       @relation(fields: [accountId], references: [id])
  waktuMulai            DateTime      @default(now())
  waktuSelesai          DateTime?
  durasiTerpakaiDetik   Int           @default(0)
  status                SessionStatus @default(BERJALAN)
  disconnectedAt        DateTime?
}

model Transaction {
  id           String           @id @default(uuid())
  accountId    String
  account      Account          @relation(fields: [accountId], references: [id])
  nominal      Int
  durasiMenit  Int
  durasiDetik  Int              @default(0)
  jenis        TransactionType
  kasirId      String
  kasir        User             @relation(fields: [kasirId], references: [id])
  dibatalkan   DateTime?
  dibatalkanOleh String?
  createdAt    DateTime         @default(now())
}

model DailyReport {
  id                 String   @id @default(uuid())
  tanggal            DateTime @unique @db.Date
  totalLogin         Int      @default(0)
  voucherTerbentuk   Int      @default(0)
  voucherTopup       Int      @default(0)
  memberTerbentuk    Int      @default(0)
  memberTopup        Int      @default(0)
  pendapatanVoucher  Int      @default(0)
  pendapatanMember   Int      @default(0)
}

model Setting {
  key   String @id
  value String
}

model ActivityLog {
  id        String   @id @default(uuid())
  event     String
  detail    String?
  pcId      String?
  accountId String?
  kasirId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}