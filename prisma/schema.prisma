generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  KASIR
}

enum PcStatus {
  IDLE
  ACTIVE
  OFFLINE
}

enum AccountType {
  VOUCHER
  MEMBER
}

enum AccountStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SessionStatus {
  BERJALAN
  SELESAI
  DISTOP
}

enum TransactionType {
  BELI_BARU
  TOPUP
  KOREKSI
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  passwordHash  String
  role          Role
  createdAt     DateTime @default(now())
  transactions  Transaction[]
  devices       Perangkat[]
}

/// Token perangkat untuk notifikasi push (FCM).
///
/// Token diikat ke user, bukan ke satu perangkat fisik: begitu akun dihapus,
/// semua token-nya ikut terhapus. `onDelete: Cascade` itu wajib ditulis
/// eksplisit karena seluruh skema ini tidak memakai `onDelete` sama sekali,
/// jadi default-nya RESTRICT dan penghapusan user akan ditolak PostgreSQL.
model Perangkat {
  id         String   @id @default(uuid())
  token      String   @unique
  platform   String   @default("android")
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model Pc {
  id               String   @id @default(uuid())
  namaPc           String
  ipClient         String
  status           PcStatus @default(IDLE)
  lastHeartbeatAt  DateTime?
  agentToken       String   @unique

  // ⚠️ `rusak` BUKAN berarti PC ini benar-benar rusak. Itu flag operasional:
  // operator menandainya saat PC sedang diservis atau sengaja dikosongkan.
  //
  // PC yang ditandai TIDAK muncul di dashboard, halaman login, dan aplikasi
  // mobile — hanya di Halaman PC, supaya flag bisa dibatalkan. Sesi baru
  // ditolak di `SessionService.createSessionAndStart()`, dan sesi yang sedang
  // berjalan langsung dihentikan saat flag dinyalakan.
  //
  // ⚠️ Kolom ini TIDAK boleh dipakai untuk menyaring laporan. Rekap dihitung
  // dari `Transaction`/`Session`, jadi PC yang ditandai tetap masuk rekap.
  rusak            Boolean  @default(false)
  alasanRusak      String?

  sessions         Session[]
}

model Account {
  id             String        @id @default(uuid())
  tipe           AccountType
  kodeUnik       String?       @unique
  nama           String?
  passwordHash   String
  sisaWaktuDetik Int           @default(0)
  status         AccountStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  lastUsedAt     DateTime?
  sessions       Session[]
  transactions   Transaction[]
}

model Session {
  id                    String        @id @default(uuid())
  pcId                  String
  pc                    Pc            @relation(fields: [pcId], references: [id])
  accountId             String
  account               Account       @relation(fields: [accountId], references: [id])
  waktuMulai            DateTime      @default(now())
  waktuSelesai          DateTime?
  durasiTerpakaiDetik   Int           @default(0)
  status                SessionStatus @default(BERJALAN)
  disconnectedAt        DateTime?
}

model Transaction {
  id           String           @id @default(uuid())
  accountId    String
  account      Account          @relation(fields: [accountId], references: [id])
  nominal      Int
  durasiMenit  Int
  durasiDetik  Int              @default(0)
  jenis        TransactionType
  kasirId      String
  kasir        User             @relation(fields: [kasirId], references: [id])
  dibatalkan   DateTime?
  dibatalkanOleh String?
  createdAt    DateTime         @default(now())
}

model DailyReport {
  id                 String   @id @default(uuid())
  tanggal            DateTime @unique @db.Date
  totalLogin         Int      @default(0)
  voucherTerbentuk   Int      @default(0)
  voucherTopup       Int      @default(0)
  memberTerbentuk    Int      @default(0)
  memberTopup        Int      @default(0)
  pendapatanVoucher  Int      @default(0)
  pendapatanMember   Int      @default(0)
}

model Setting {
  key   String @id
  value String
}

model ActivityLog {
  id        String   @id @default(uuid())
  event     String
  detail    String?
  pcId      String?
  accountId String?
  kasirId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}